# Copy to .env and fill in real values locally. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://revpilot:revpilot@localhost:5432/revpilot
POSTGRES_USER=revpilot
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=revpilot
DOMAIN=app.example.com

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI provider ---
# huggingface | mock  (mock = MockAIProvider, no external calls, DEMO_MODE friendly)
# huggingface = a free, open-weight model via Hugging Face's Inference
# Providers router (https://router.huggingface.co) -- NOT a paid API.
# Get a free token: https://huggingface.co/settings/tokens/new
#   (enable the "Make calls to Inference Providers" permission)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Payments ---
# razorpay | mock  (mock = MockPaymentProvider, UI labels it "Demo Payment Mode")
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Demo ---
DEMO_MODE=true

# --- Frontend (Vite reads VITE_-prefixed vars) ---
VITE_API_URL=http://localhost:8000
